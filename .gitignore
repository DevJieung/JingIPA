# Godot
.godot/
*.translation

# 만들어지는 것들 — 촬영본 · 로그 · APK
build/*
!build/.gdignore

# 그림은 GPU 로 다시 만들 수 있지만, 한 시간 걸리므로 저장소에 넣는다.
# (art/ 는 일부러 무시하지 않는다)

# 파이썬
__pycache__/
*.pyc
override.cfg
.env
.env.*

# CI regenerates the engine's Android template and machine-specific settings.
/android/build/
/android/.build_version
*.apk
*.ipa
*.keystore
*.jks
*.p12
*.mobileprovision

# Offline generation sources; shipped art/anim, themes, audio and UI stay in Git.
/art/animation/
/art/concepts/
/art/audio_sources/
/art/portraits/sources/
