; 놀이 상자 — Godot 4.7.1
;
; 손으로 작성한 파일이다. 근거는 docs/architecture.md.
; ★ 지우면 조용히 깨지는 값들 — 각 줄의 주석을 반드시 읽을 것.

config_version=5

[application]

config/name="놀이 상자"
; 애플은 App ID 이름에 영문·숫자만 받는다. 지우면 무료 서명(AltStore/Sideloadly)이
; 한글 이름으로 App ID 를 못 만들어 설치가 막힌다. ★삭제 금지
; ★ 이 ASCII 이름과 번들 ID 는 바꾸지 마라. 바꾸면 애플/안드로이드가 다른 앱으로 보고
;   아이 폰의 기존 저장 데이터가 통째로 남남이 된다. 표시 이름(config/name)만 바꾼다.
config/name.ios="DinoIsland"
config/description="공룡 찾기 · 손전등 찾기 · 셈놀이 · 블록 채우기 — 아이용 놀이 모음"
config/version="1.0.0"
; ★저장 폴더 이름을 앱 표시 이름에서 분리한다.
;   use_custom_user_dir 이 true 여야 custom_user_dir_name 이 실제로 쓰인다 —
;   이름만 넣으면 조용히 무시되고 config/name 이 폴더 이름이 된다(실제로 물렸다).
;   이걸 안 걸어 두면 앱 이름을 바꾸는 순간 데스크톱에서 user:// 경로가 통째로
;   바뀌어 아이 기록이 사라진 것처럼 보인다.
config/use_custom_user_dir=true
config/custom_user_dir_name="rogame"
; 진입점은 게임이 아니라 셸이다. 게임은 shell/game_registry.gd 에 등록된다.
run/main_scene="res://shell/boot.tscn"
; ★"4.7" 이어야 한다. games/math/game/block_stage.gd 가 4.7 신규 API
;   Tween.has_tweeners() 를 쓴다 — 트위너 없는 Tween 은 finished 를 안 내서
;   이 가드가 없으면 블록 시연이 영원히 멈춘다. (공룡찾기 쪽은 4.4 였다)
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0.976, 0.945, 0.882, 1)

[autoload]

; ★순서가 곧 의존 순서다.
;   Shell 이 저장 파일을 소유하므로 가장 먼저.
;   Audio._ready() 가 MathGame.settings_changed 에 연결하므로 MathGame 이 Audio 보다 먼저.
;   Router 는 Shell/GameRegistry 를 부르므로 마지막.
; ★'Game' 이라는 이름은 비워 둔다 — 게임이 여러 개인 앱에서 Game.stars 는 거짓말이고,
;   세 번째 게임이 또 자기를 Game 이라 부르고 싶어 한다.
;   게다가 오토로드 Game 이 있으면 같은 이름의 씬 루트가 경고 없이 @Node2D@N 으로 개명된다.
Shell="*res://shell/shell.gd"
MathGame="*res://games/math/autoload/math_game.gd"
Audio="*res://games/math/autoload/audio.gd"
Router="*res://shell/router.gd"

[display]

; 기준은 가로 태블릿 1280x800 (개구리 용사 값). games/math/core/layout.gd 의 Layout.BASE 와 같아야 한다.
; ★공룡 찾기만 진입 시 Shell.enter_game() 이 1280x720 / keep 으로 런타임 전환한다.
;   공룡 찾기는 소품 y 좌표 42개(games/dino/scripts/rooms.gd)와 바닥선 FY=470 이
;   720 에 손으로 맞춰져 있어서 800 으로 올리면 통째로 다시 맞춰야 한다.
;   반대로 720/keep 으로 통일하면 노치 있는 아이폰에서 셈놀이 답 버튼이
;   24px 화면 밖으로 나간다 (800 - 720 = 80px 이 정확히 노치 여유분이다).
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1000
window/size/window_height_override=625
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Godot 4 에서는 문자열이 아니라 정수다. 4 = 센서 가로.
window/handheld/orientation=4

[gui]

; ★커버리지가 넓은 쪽이 fallback 이다. 이게 상식과 반대라 헷갈리기 쉽다.
;   DinoKR = Noto Sans CJK KR Bold, 한글 11,172/11,172 (100%)
;   Jua    = 한글 2,367/11,172 (21.2%). `·`(U+00B7) 조차 없다.
;   공룡 찾기·허브·블록 채우기는 이 값에 전적으로 의존한다.
;   셈놀이는 Fonts.MAIN 으로 Jua 를 직접 preload 하므로 이 값을 안 쓴다.
;   ⚠ 두 .import 다 allow_system_fallback=true 라 실기기에서는 빠진 글리프를 OS 폰트가
;     메워 준다 → 눈으로는 절대 못 잡는다. tools/check_font.py 를 반드시 돌릴 것.
theme/custom_font="res://core/fonts/DinoKR.ttf"

[input_devices]

; 공룡 찾기가 InputEventMouseButton 만 본다. 기본값이 true 이지만 명시해 둔다.
pointing/emulate_mouse_from_touch=true

[physics]

; 두 게임 다 _physics_process 를 안 쓴다. 배터리에 좋다.
; ⚠ 앞으로 물리를 쓰는 게임을 넣으면 조용히 30Hz 로 돈다는 걸 기억할 것.
common/physics_ticks_per_second=30

[rendering]

; iOS A12 미만 기기 호환을 위해. mobile/forward_plus 로 바꾸면 Godot 이
; iphone-ipad-minimum-performance-a12 를 강제 주입해 2018년 이전 기기가 잘려 나간다.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; ★없으면 x86_64 러너(GitHub Actions)에서 오류 메시지도 없이 익스포트가 거부된다. 삭제 금지.
textures/vram_compression/import_etc2_astc=true
; ★공룡 찾기에만 있던 줄. 공룡 찾기에는 수동 AA 코드가 전혀 없어서
;   도형의 매끄러움이 전적으로 이 설정에서 나온다. 실측 기본값은 0 이다.
;   ⚠ 이 줄 때문에 docs/math-rules.md 규칙 1의 *전제*("gl_compatibility 라 MSAA 가 없다")가
;     사실이 아니게 된다. 규칙 자체(DrawUtil.fill_aa 로만 채우기)는 유지하고 주석만 고칠 것 —
;     걷어내면 공룡 화면 전후로 그림 품질이 달라진다.
anti_aliasing/quality/msaa_2d=2
; ★공룡 찾기에만 있던 줄. 512px 공룡 PNG 50장을 116~184px 로 줄여 그리므로
;   밉맵이 없으면 공룡이 지글거린다. 실측 기본값은 1 이다.
;   다른 게임은 그림 파일을 안 쓰므로 영향이 없다.
textures/canvas_textures/default_texture_filter=3
; 실제로 이 색이 보이는 곳은 레터박스 여백과 부팅 순간뿐이다.
; 게임별 색은 Shell.enter_game() 이 RenderingServer.set_default_clear_color() 로 바꾼다.
environment/defaults/default_clear_color=Color(0.976, 0.945, 0.882, 1)
